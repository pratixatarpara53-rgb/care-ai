# ══════════════════════════════════════════════════════════════════
# SwasthyaSetu AI – Environment Variables Template
# ══════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file to .env:
#         cp .env.example .env
#   2. Fill in the values below with your actual credentials.
#   3. NEVER commit your .env file to version control.
#      The .gitignore already excludes .env
#
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# IBM Watsonx.ai / IBM Cloud Credentials
# ──────────────────────────────────────────────
# Your IBM Cloud API Key (IAM).
# Create one at: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your Watsonx.ai Project ID.
# Find it in: Watsonx.ai > Manage > General > Project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Watsonx.ai API endpoint (change region if needed)
# Available regions: us-south, eu-de, eu-gb, jp-tok, au-syd
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use (do not change unless you have access to a different model)
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ──────────────────────────────────────────────
# Flask Application Settings
# ──────────────────────────────────────────────
# Set to "true" for development (enables debug mode and auto-reload)
# Set to "false" or remove for production
FLASK_DEBUG=false

# Port the Flask server listens on (default: 5000)
PORT=5000

# Allowed CORS origins (comma-separated, or * for all)
# In production, restrict this to your actual domain
ALLOWED_ORIGINS=*

# ══════════════════════════════════════════════════════════════════
# NOTE: If WATSONX_API_KEY and WATSONX_PROJECT_ID are not set,
# the application runs in DEMO MODE with pre-configured educational
# responses. All UI features remain functional in demo mode.
# ══════════════════════════════════════════════════════════════════
